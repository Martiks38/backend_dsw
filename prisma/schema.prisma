generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ServiceStatus {
  PENDING
  IN_PROGRESS
  SCHEDULED
  COMPLETED
  CANCELED
}

enum EmployeeType {
  ADMIN
  OPERATOR
}

enum OperationType {
  MANUAL
  AUTOMATIC
}

model Boat {
  boatId Int @id @default(autoincrement()) @map("boat_id")

  publicId           String   @unique @map("public_id")
  name               String
  model              String
  registrationNumber String   @map("registration_number")
  description        String
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @map("updated_at")

  boatTypeId Int @map("boat_type_id")
  userId     Int @map("user_id")

  boatType BoatType @relation(fields: [boatTypeId], references: [boatTypeId])
  member   Member   @relation(fields: [userId], references: [userId])

  contracts       Contract[]
  departures      BoatDeparture[]
  serviceRequests ServiceRequest[]

  @@map("boats")
}

model BoatType {
  boatTypeId Int @id @default(autoincrement()) @map("boat_type_id")

  name              String
  requiredOperation OperationType @map("required_operation")

  boats Boat[]

  @@map("boat_types")
}

model BoatDeparture {
  boatDepartureId Int      @id @default(autoincrement()) @map("boat_departure_id")
  exitedAt        DateTime @map("exited_at")
  boatId          Int      @map("boat_id")

  estimatedReturnDatetime DateTime  @map("estimated_return_datetime")
  realReturnDatetime      DateTime? @map("real_return_datetime")

  boat Boat @relation(fields: [boatId], references: [boatId])

  serviceRequestId Int            @unique @map("service_request_id")
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [serviceRequestId])

  @@map("boat_departures")
}

model Cradle {
  cradleId   Int    @id @default(autoincrement()) @map("cradle_id")
  state      String
  cradleCode String @map("cradle_code")

  boatHasBoatSlips Contract[]

  @@map("cradles")
}

model Contract {
  contractId    Int      @id @default(autoincrement()) @map("contract_id")
  startDatetime DateTime @map("start_datetime")
  boatId        Int      @map("boat_id")

  endDatetime DateTime? @map("end_datetime")

  cradleId Int @map("cradle_id")

  boat   Boat   @relation(fields: [boatId], references: [boatId])
  cradle Cradle @relation(fields: [cradleId], references: [cradleId])

  @@map("contracts")
}

model User {
  userId Int @id @default(autoincrement()) @map("user_id")

  publicId       String   @unique @map("public_id")
  email          String   @unique
  password       String
  phoneNumber    String   @map("phone_number")
  documentType   String   @map("document_type")
  documentNumber String   @map("document_number")
  isActive       Boolean  @default(true) @map("is_active")
  isEmployee     Boolean  @default(false) @map("is_employee")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @map("updated_at")

  passwordResetTokens PasswordResetToken[]

  employee Employee?
  member   Member?

  @@unique([documentType, documentNumber])
  @@map("users")
}

model Employee {
  userId Int @id @map("user_id")

  firstName      String       @map("first_name")
  lastName       String       @map("last_name")
  employeeNumber String       @unique @map("employee_number")
  employeeType   EmployeeType @map("employee_type")

  user            User             @relation(fields: [userId], references: [userId])
  serviceRequests ServiceRequest[]

  @@map("employees")
}

model Member {
  userId Int @id @map("user_id")

  firstName    String? @map("first_name")
  lastName     String? @map("last_name")
  businessName String? @map("business_name")

  user User @relation(fields: [userId], references: [userId])

  boat            Boat[]
  serviceRequests ServiceRequest[]

  @@map("members")
}

model PasswordResetToken {
  passwordResetTokenId Int      @id @default(autoincrement()) @map("password_reset_token_id")
  userId               Int      @map("user_id")
  user                 User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  tokenHash            String   @unique @map("token_hash")
  expiresAt            DateTime @map("expires_at")
  used                 Boolean  @default(false)
  createdAt            DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

model ServiceRequest {
  serviceRequestId  Int           @id @default(autoincrement()) @map("service_request_id")
  status            ServiceStatus @default(PENDING)
  requestedDatetime DateTime      @map("requested_datetime")
  observations      String?
  internalComment   String?       @map("internal_comment")
  createdAt         DateTime      @default(now()) @map("created_at")

  scheduledDate DateTime? @map("scheduled_date")
  scheduledTime String?   @map("scheduled_time")
  sector        String?

  boatDeparture BoatDeparture?

  serviceTypeId Int         @map("service_type_id")
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [serviceTypeId])

  requestedByUserId Int    @map("requested_by_user_id")
  member            Member @relation(fields: [requestedByUserId], references: [userId])

  assignedEmployeeId Int?      @map("assigned_employee_id")
  employee           Employee? @relation(fields: [assignedEmployeeId], references: [userId])

  boatId Int  @map("boat_id")
  boat   Boat @relation(fields: [boatId], references: [boatId])

  @@index([assignedEmployeeId, scheduledDate])
  @@map("service_requests")
}

model ServiceType {
  serviceTypeId Int     @id @default(autoincrement()) @map("service_type_id")
  name          String
  description   String?
  isActive      Boolean @default(true) @map("is_active")

  serviceRequests ServiceRequest[]

  @@map("service_types")
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum ServiceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum EmployeeType {
  ADMIN
  OPERATOR
}

enum OperationType {
  MANUAL
  AUTOMATIC
}

model Boat {
  boatId Int @id

  publicId    String @unique
  name        String
  description String

  boatTypeId Int
  userId     Int

  boatType BoatType @relation(fields: [boatTypeId], references: [boatTypeId])
  member   Member   @relation(fields: [userId], references: [userId])

  contracts       Contract[]
  departures      BoatDeparture[]
  serviceRequests ServiceRequest[]

  @@map("boats")
}

model BoatType {
  boatTypeId Int @id @default(autoincrement())

  name              String
  requiredOperation OperationType

  boats Boat[]

  @@map("boat_types")
}

model BoatDeparture {
  exitedAt DateTime
  boatId   Int

  estimatedReturnDatetime DateTime
  realReturnDatetime      DateTime?

  boat Boat @relation(fields: [boatId], references: [boatId])

  serviceRequestId Int            @unique
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [serviceRequestId])

  @@id([exitedAt, boatId])
  @@map("boat_departures")
}

model Cradle {
  cradleId   Int    @id @default(autoincrement())
  state      String
  cradleCode String

  boatHasBoatSlips Contract[]

  @@map("cradles")
}

model Contract {
  contractId    Int      @id @default(autoincrement())
  startDatetime DateTime
  boatId        Int

  endDatetime DateTime?

  cradleId Int

  boat   Boat   @relation(fields: [boatId], references: [boatId])
  cradle Cradle @relation(fields: [cradleId], references: [cradleId])

  @@map("contracts")
}

model User {
  userId Int @id @default(autoincrement())

  publicId       String  @unique
  email          String  @unique
  password       String
  phoneNumber    String
  documentType   String
  documentNumber String
  isActive       Boolean @default(true)
  isEmployee     Boolean @default(false)

  passwordResetTokens PasswordResetToken[]

  employee Employee?
  member   Member?

  @@unique([documentType, documentNumber])
  @@map("users")
}

model Employee {
  userId Int @id

  firstName      String
  lastName       String
  employeeNumber String       @unique
  employeeType   EmployeeType

  user            User             @relation(fields: [userId], references: [userId])
  serviceRequests ServiceRequest[]

  @@map("employees")
}

model Member {
  userId Int @id

  firstName    String?
  lastName     String?
  businessName String?

  user User @relation(fields: [userId], references: [userId])

  boat            Boat[]
  serviceRequests ServiceRequest[]

  @@map("members")
}

model PasswordResetToken {
  passwordResetTokenId Int      @id @default(autoincrement()) @map("password_reset_token_id")
  userId               Int      @map("user_id")
  user                 User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  tokenHash            String   @unique @map("token_hash")
  expiresAt            DateTime @map("expires_at")
  used                 Boolean  @default(false)
  createdAt            DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

model ServiceRequest {
  serviceRequestId  Int           @id @default(autoincrement())
  status            ServiceStatus @default(PENDING)
  requestedDatetime DateTime
  observations      String?
  internalComment   String?
  createdAt         DateTime      @default(now())

  boatDeparture BoatDeparture?

  serviceTypeId Int         @map("service_type_id")
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [serviceTypeId])

  requestedByUserId Int    @map("requested_by_user_id")
  member            Member @relation(fields: [requestedByUserId], references: [userId])

  assignedEmployeeId Int      @map("assigned_employee_id")
  employee           Employee @relation(fields: [assignedEmployeeId], references: [userId])

  boatId Int
  boat   Boat @relation(fields: [boatId], references: [boatId])

  @@map("service_requests")
}

model ServiceType {
  serviceTypeId Int     @id @default(autoincrement())
  name          String
  description   String?
  isActive      Boolean @default(true)

  serviceRequests ServiceRequest[]

  @@map("service_types")
}

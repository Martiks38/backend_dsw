// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model Boat {
  hin Int @id

  publicId    String @unique
  name        String
  description String

  boatTypeId Int
  userId     Int

  boatType BoatType @relation(fields: [boatTypeId], references: [boatTypeId])
  member   Member   @relation(fields: [userId], references: [userId])

  contracts  Contract[]
  departures BoatDeparture[]

  @@map("boats")
}

model Activity {
  activityId Int @id @default(autoincrement())

  publicId    String @unique
  name        String
  description String

  boatTypeId Int
  boatType   BoatType @relation(fields: [boatTypeId], references: [boatTypeId])

  employees EmployeesActivities[]

  @@map("activities")
}

model BoatType {
  boatTypeId Int @id @default(autoincrement())

  name              String
  requiredOperation String

  boats      Boat[]
  activities Activity[]

  @@map("boat_types")
}

model BoatDeparture {
  exitedAt DateTime
  boatId   Int

  publicId                String    @unique
  estimatedReturnDatetime DateTime
  realReturnDatetime      DateTime?

  boat Boat @relation(fields: [boatId], references: [hin])

  @@id([exitedAt, boatId])
  @@map("boat_departures")
}

model Cradle {
  cradleId Int @id

  state        String
  cradleCode   String
  sizeCategory CradleSizeCategory
  isOccupied   Boolean

  boatHasBoatSlips Contract[]

  cradleCategoryId Int

  cradleCategory CradleCategory @relation(fields: [cradleCategoryId], references: [cradleCategoryId])

  @@map("cradles")
}

model CradleCategory {
  cradleCategoryId Int @id @default(autoincrement())

  name           String
  hierarchyLevel Int

  cradles       Cradle[]
  cradleTariffs CradleTariff[]

  @@map("cradle_categories")
}

model CradleTariff {
  cradleCategoryId Int
  startDate        DateTime

  monthlyPrice Decimal

  cradleCategory CradleCategory @relation(fields: [cradleCategoryId], references: [cradleCategoryId])

  @@id([startDate, cradleCategoryId])
  @@map("cradle_tariffs")
}

model Contract {
  startDatetime DateTime
  boatId        Int

  endDatetime DateTime?

  cradleId Int

  boat   Boat   @relation(fields: [boatId], references: [hin])
  cradle Cradle @relation(fields: [cradleId], references: [cradleId])

  installments Installment[]

  @@id([startDatetime, boatId])
  @@map("contracts")
}

model User {
  userId Int @id @default(autoincrement())

  publicId    String  @unique
  email       String  @unique
  password    String
  phoneNumber String
  isActive    Boolean @default(true)
  isEmployee  Boolean @default(false)

  employee Employee?
  member   Member?

  @@map("users")
}

model Employee {
  userId Int @id

  firstName      String
  lastName       String
  employeeNumber String  @unique
  employeeType   String
  licenseNumber  String?

  user User @relation(fields: [userId], references: [userId])

  activities EmployeesActivities[]

  @@map("employees")
}

model Member {
  userId Int @id

  documentType   String?
  documentNumber String?
  firstName      String?
  lastName       String?
  businessName   String?

  user User @relation(fields: [userId], references: [userId])

  boat        Boat[]
  enrollments Enrollment[]

  @@unique([documentType, documentNumber])
  @@map("members")
}

model EmployeesActivities {
  employeeId Int
  activityId Int

  employee Employee @relation(fields: [employeeId], references: [userId])
  activity Activity @relation(fields: [activityId], references: [activityId])

  courses Course[]

  @@id([employeeId, activityId])
  @@map("employees_activities")
}

model Course {
  courseId Int @id @default(autoincrement())

  publicId   String   @unique
  capacity   Int
  start_date DateTime
  end_date   DateTime
  name       String

  activityId Int
  employeeId Int

  employeeActivity EmployeesActivities @relation(fields: [employeeId, activityId], references: [employeeId, activityId])

  enrollments     Enrollment[]
  courseSchedules CourseSchedule[]
  coursePrices    CoursePrice[]

  @@map("courses")
}

model CourseSchedule {
  weekday String

  startTime DateTime
  endTime   DateTime

  courseId Int

  course Course @relation(fields: [courseId], references: [courseId])

  @@id([weekday, courseId])
  @@map("course_schedules")
}

model CoursePrice {
  startDate DateTime

  enrollmentPrice  Decimal
  installmentPrice Decimal

  courseId Int
  course   Course @relation(fields: [courseId], references: [courseId])

  @@id([startDate, courseId])
  @@map("course_prices")
}

model Enrollment {
  memberId Int
  courseId Int

  registered_at DateTime
  status        StatusEnrollment @default(ACTIVE)

  course Course @relation(fields: [courseId], references: [courseId])
  member Member @relation(fields: [memberId], references: [userId])

  installments Installment[]

  @@id([memberId, courseId])
  @@map("enrollments")
}

model Installment {
  installmentId Int @id @default(autoincrement())

  publicId          String            @unique
  paymentDate       DateTime
  installmentStatus InstallmentStatus @default(PENDING)
  installmentType   InstallmentType
  amount            Decimal

  userId        Int
  courseId      Int
  startDatetime DateTime
  boatId        Int

  enrollment Enrollment @relation(fields: [userId, courseId], references: [memberId, courseId])
  contract   Contract   @relation(fields: [startDatetime, boatId], references: [startDatetime, boatId])

  @@map("installments")
}

enum CradleSizeCategory {
  SMALL
  MEDIUM
  LARGE
}

enum StatusEnrollment {
  ACTIVE
  COMPLETED
  DROPPED
}

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
}

enum InstallmentType {
  ENROLLMENT
  CRADLE_RENTAL
}
